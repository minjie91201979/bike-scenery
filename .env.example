# NetEase music API base (no trailing slash). Empty = built-in mock library.
#
# Dev (Vite same-origin proxy → avoids CORS; see vite.config.ts /ncm):
#   VITE_MUSIC_API=/ncm
#
# Direct to local third-party NeteaseCloudMusicApi (内测):
#   VITE_MUSIC_API=http://127.0.0.1:3000
#
# Android APK on LAN (phone → PC running the API):
#   VITE_MUSIC_API=http://<pc-lan-ip>:3000
#
# Start the third-party API (内测, 不可商用):
#   npx NeteaseCloudMusicApi@latest
#   # or: docker run -p 3000:3000 binaryify/netease_cloud_music_api
#   # PORT=3000 by default
#
# Official NetEase openapi has no stream/playback URLs — do not switch to it.
VITE_MUSIC_API=/ncm
